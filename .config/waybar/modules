{
  //Network Speed
  "network#down": {
    "interface": "enp6s0",
    "interval": 15,
    "format": "{bandwidthDownBytes}"
  },
  "network#up": {
    "interface": "enp6s0",
    "interval": 15,
    "format": "{bandwidthUpBytes}"
  },
  "network": {
    "interface": "enp6s0",
    "interval": 15,
    "format": "{bandwidthUpBytes}\n{bandwidthDownBytes}"
  },
  "custom/networkicon": {
    "format": "",
  },
  "group/networkspeedin": {
    "orientation": "vertical",
    "modules": [
      "network#up",
      "network#down"
    ]
  },
  "group/networkspeed": {
    "orientation": "horizontal",
    "modules": [
      "custom/networkicon",
      "group/networkspeedin"
    ]
  },
  // PC stats 
  //
  "disk#root": {
    "interval": 30,
    "format": "{used}\n{total}",
    "path": "/"
  },
  "disk#dane": {
    "interval": 30,
    "format": "{used}\n{total}",
    "path": "/home/pawelkuzia/mnt/Dane"
  },
  "disk#magazyn": {
    "interval": 30,
    "format": "{used}\n{total}",
    "path": "/home/pawelkuzia/mnt/Magazyn"
  },
  "disk#rootl2": {
    "interval": 30,
    "format": "{total}",
    "path": "/"
  },
  "custom/diskicon": {
    "format": "",
    "tooltip": false,
  },
  "group/disks#root": {
    "orientation": "horizontal",
    "modules": [
      "custom/diskicon",
      "disk#root"
    ]
  },
  "group/disks#dane": {
    "orientation": "horizontal",
    "modules": [
      "custom/diskicon",
      "disk#dane"
    ]
  },
  "group/disks#mag": {
    "orientation": "horizontal",
    "modules": [
      "custom/diskicon",
      "disk#magazyn"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": "300",
      "children-class": "system-child",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "group/disks#root",
      "group/disks#dane",
      "group/disks#mag",
      "memory"
    ]
  },
  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty bashtop"
    //"tooltip": false,
    // "format_alt": "{temperatureC}°C "
  },
  "memory": {
    "format": " {}%"
  },
  // Centerpill 
  //
  "group/centerpill": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "custom/weather"
    ]
  },
  "clock": {
    "format": "{:%H:%M    %Y-%m-%d}",
    "timezone": "Europe/Warsaw",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 3600,
    "exec": "wttrbar",
    "return-type": "json"
  },
  "custom/spacer": {
    "format": " ",
  },
  // Music Info & Cava 
  //
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "mpris#icon",
      "mpris",
      "cava"
    ]
  },
  "mpris#icon": {
    "format": "{player_icon}",
    "format-paused": "{player_icon}",
    "player-icons": {
      "mpv": "🎵",
      "spotify": "",
      "spotify_player": "",
      "firefox": "󰗃",
      "YoutubeMusic": "󰝚",
      "default": "󰓃"
    },
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "ignored-players": [
      "firefox",
      "qutebrowser",
      "chromium",
    ]
  },
  "mpris": {
    "format": "{title}\n<span font='12px'>┗ {artist}</span>",
    "format-paused": "{status_icon} {title}\n<span font='12px'>┗ {artist}</span>",
    "player-icons": {
      "mpv": "🎵",
      "spotify": "",
      "spotify_player": "",
      "firefox": "󰗃",
      "YoutubeMusic": "󰝚",
      "default": "󰓃"
    },
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "ignored-players": [
      "firefox",
      "chromium"
    ]
  },
  "cava": {
    //"cava_config": "$HOME/.config/cava/config",
    "framerate": 30,
    "autosens": 1,
    "overshoot": 0,
    "sensitivity": 3,
    "bars": 10,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "hide_on_silence": false,
    "sleep_timer": 5,
    // "method": "pulse",
    // "source": "alsa_output.usb-TC-Helicon_GoXLRMini-00.HiFi__Speaker__sink",
    "stereo": false,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.5,
    "input_delay": 2,
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "on-click": "pypr toggle mixerquake",
    "actions": {
      "on-click-right": "mode"
    }
  },
  "wlr/taskbar#dock": {
    "format": "{icon}",
    "icon-size": 36,
    "tooltip-format": "{title}",
    "all-outputs": true,
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": false,
    "ignore-list": [
      "Alacritty",
      "alaquake",
      "AudioMixer"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "Foot Server": "Terminal"
    }
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "all-outputs": false,
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": false,
    "ignore-list": [
      "Alacritty",
      "alaquake"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "Foot Server": "Terminal"
    }
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "active-only": false,
    "all-outputs": false,
    "sort-by": "number",
    "on-scroll-up": "hyprctl dispatch workspace m+1",
    "on-scroll-down": "hyprctl dispatch workspace m-1",
    "format-icons": {
      "3": "",
      "2": "",
      "1": "",
      "11": "󰍩",
      "12": "󰖟",
      "4": "󰺻",
      "6": "󱜠",
      "5": "",
      "24": "󰖟",
      "urgent": "",
      "focused": "",
      "10": "󰊓",
      "default": ""
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 18,
    "max-length": 40,
    "rewrite": {
      "(.*) — Mozilla Firefox": "Mozilla Firefox",
      "(.*) - Geany": "Geany",
      "(.*) - fish": "> [$1]"
    },
    "separate-outputs": true,
  },
  "custom/launcher": {
    "tooltip": false,
    "format": "󰣇",
    "on-click": "rofi -show combi"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "󱅫",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/wallpaper": {
    "format": "",
    "tooltip": false,
    // "on-click-right": "kitty --class WallpaperPicker --hold=no -e ~/Scripts/selectwall.sh",
    "on-click": "hyprctl dispatch exec /home/pawelkuzia/Scripts/next_wallpaper.sh",
    // "on-click": "kitty --class pywal zsh -ic '/home/pawelkuzia/Scripts/next_wallpaper.sh'",
    "on-click-right": "hyprctl dispatch exec waypaper"
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
  },
  // Secondary panels modules
  //
  "clock#small": {
    "timezone": "Europe/Warsaw",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "custom/browser#docklauncher": {
    "format": "󰖟",
    "tooltip": "Browser",
    "on-click": "hyprctl dispatch exec firefox"
  },
  "custom/discord#docklauncher": {
    "format": "",
    "tooltip": "Discord",
    "on-click": "hyprctl dispatch exec firefoxpwa site launch 01H8C8XZH1X1HBPHWAW5P10GFW"
  },
  "custom/messenger#docklauncher": {
    "format": "",
    "tooltip-format": "Messenger",
    "on-click": "hyprctl dispatch exec firefoxpwa site launch 01J41TQGQSX2CBCRW167B1WSF5"
  },
  "custom/thunderbird#docklauncher": {
    "format": "",
    "tooltip-format": "Mail",
    "on-click": "hyprctl dispatch exec thunderbird"
  },
  "custom/steam#docklauncher": {
    "format": "",
    "tooltip-format": "Steam",
    "on-click": "hyprctl dispatch exec steam"
  },
  "custom/heroic#docklauncher": {
    "format": "",
    "tooltip-format": "Mail",
    "on-click": "hyprctl dispatch exec thunderbird"
  },
  "custom/lutris#docklauncher": {
    "format": "",
    "tooltip-format": "Mail",
    "on-click": "hyprctl dispatch exec thunderbird"
  },
  "custom/obs#docklauncher": {
    "format": "",
    "tooltip-format": "Mail",
    "on-click": "hyprctl dispatch exec thunderbird"
  },
  "group/dockapps": {
    "orientation": "horizontal",
    "modules": [
      "custom/browser#docklauncher",
      "custom/thunderbird#docklauncher",
      "custom/discord#docklauncher",
      "custom/messenger#docklauncher",
      "custom/steam#docklauncher",
    ]
  }
}
